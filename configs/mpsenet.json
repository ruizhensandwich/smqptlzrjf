{
  "model": "mpsenet",
  "model_args": {"n_fft": 400, "hop": 100, "win": 400, "dense_channel": 64, "num_tsblocks": 4,
                 "n_heads": 4, "beta": 2.0, "compress_factor": 0.3},
  "loss": "mpsenet",
  "discriminator": "metric",
  "data": {"segment_seconds": 2.0, "remix_prob": 0.5, "remix_snr_db": [-5.0, 20.0],
           "gain_db": [0.0, 0.0]},
  "train": {
    "seed": 1234, "batch_size": 4, "val_batch_size": 4,
    "optimizer": "adamw", "lr": 0.0005, "adam_betas": [0.8, 0.99], "weight_decay": 0.01,
    "scheduler": "exponential", "lr_gamma": 0.99,
    "max_epochs": 300, "min_epochs": 100, "patience": 60, "min_delta": 0.001,
    "save_epochs": [25, 50, 100, 150, 200]
  },
  "note": "MP-SENet (yxlu-0102/MP-SENet, MIT) from scratch: source settings (batch 4, 2 s segments, AdamW 5e-4, betas 0.8/0.99, lr x0.99 per epoch, metric discriminator) + dynamic remixing of half the items"
}
